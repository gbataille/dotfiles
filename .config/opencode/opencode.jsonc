{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
  ],
  "tools": {
    "bash": false
  },
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "eu-central-1",
        "profile": "shift-dev"
      }
    },
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX",
      "options": {
        "baseURL": "http://localhost:8000/v1"
      },
      "models": {
        "Qwen3.6-35B-A3B-MLX-4bit": {
          "name": "Qwen3.6-35B-A3B-MLX-4bit",
          "limit": { "context": 200000, "output": 16384 }
        }
      }
    }
  },
  "mcp": {
    "lf-mcp-portal": {
      "type": "remote",
      "url": "https://mcp-tools.lightframe.cloud/mcp",
      "oauth": {}
    },
    "idea": {
       "type": "local",
       "command": [
          "npx",
          "-y",
          "mcp-remote",
          "http://127.0.0.1:64342/sse",
          "--allow-http"
       ]
    },
    "async-bash": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
       "mcp>=1.12.3,<2",
        "async-bash-mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:context7_api_key}"
      },
      "enabled": true
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ]
}

